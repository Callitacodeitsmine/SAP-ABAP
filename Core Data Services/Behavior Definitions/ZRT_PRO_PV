projection implementation in class zbp_rt_pro_pv unique;
strict ( 2 );
use draft;

define behavior for ZRT_PRO_PV alias Product
use etag
{
  use create;
  use update;
  use delete;

  use action reorderNow;
  use action Edit;
  use action Resume;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Movements { create; with draft; }

}

define behavior for ZRT_STOCKMOVEMENT_PV alias Movement
{
  use update;
  use delete;

  use association _Product { with draft; }
}